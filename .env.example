# Liyana NEXUS v1 - Environment Configuration
# Kopiere diese Datei zu .env und fülle deine API-Keys aus

# =============================================================================
# AI APIs - KI-Dienste
# =============================================================================

# OpenAI API (für GPT-Modelle)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Telegram Bot - Benachrichtigungen und Steuerung
# =============================================================================

# Telegram Bot Token (von @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (deine Chat-ID für Benachrichtigungen)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# E-Commerce APIs - Dropshipping und Handel
# =============================================================================

# AliExpress API
ALIEXPRESS_API_KEY=your_aliexpress_api_key_here
ALIEXPRESS_TRACKING_ID=your_aliexpress_tracking_id_here

# Shopify API
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_STORE_URL=your_shopify_store_url_here

# =============================================================================
# Finance APIs - Marktdaten und Finanzinformationen
# =============================================================================

# Alpha Vantage (Börsendaten)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# =============================================================================
# Email Configuration - E-Mail-Zugriff
# =============================================================================

# Gmail (App-Passwort verwenden, nicht normales Passwort)
GMAIL_EMAIL=your_gmail@gmail.com
GMAIL_PASSWORD=your_gmail_app_password_here

# Yahoo Mail
YAHOO_EMAIL=your_yahoo_email@yahoo.com
YAHOO_PASSWORD=your_yahoo_app_password_here

# Outlook/Hotmail
OUTLOOK_EMAIL=your_outlook_email@outlook.com
OUTLOOK_PASSWORD=your_outlook_password_here

# =============================================================================
# System Configuration - Erweiterte Einstellungen
# =============================================================================

# Debug Mode (true/false)
DEBUG_MODE=false

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Max Concurrent Agents (1-10)
MAX_CONCURRENT_AGENTS=5

# Auto Restart on Error (true/false)
AUTO_RESTART=true

# =============================================================================
# Voice Configuration - Sprachverarbeitung
# =============================================================================

# Whisper Model Size (tiny, base, small, medium, large)
WHISPER_MODEL=base

# TTS Engine (piper, silero, coqui)
TTS_ENGINE=piper

# Voice Clone Enabled (true/false)
VOICE_CLONE_ENABLED=true

# =============================================================================
# Database Configuration - Datenspeicherung
# =============================================================================

# SQLite Database Path
DATABASE_PATH=data/nexus.db

# Backup Interval (in seconds)
BACKUP_INTERVAL=3600

# Max Backups to Keep
MAX_BACKUPS=10

# =============================================================================
# Security Configuration - Sicherheitseinstellungen
# =============================================================================

# Encryption Enabled (true/false)
ENCRYPTION_ENABLED=true

# Session Timeout (in seconds)
SESSION_TIMEOUT=3600

# Rate Limiting Enabled (true/false)
RATE_LIMITING_ENABLED=true

# Max Requests per Minute
MAX_REQUESTS_PER_MINUTE=100

# =============================================================================
# Performance Configuration - Leistungseinstellungen
# =============================================================================

# Max Memory Usage (0.1 - 1.0)
MAX_MEMORY_USAGE=0.8

# Cache TTL (in seconds)
CACHE_TTL=300

# Max Cache Size
MAX_CACHE_SIZE=1000

# =============================================================================
# GUI Configuration - Benutzeroberfläche
# =============================================================================

# GUI Theme (cyberpunk, dark, light)
GUI_THEME=cyberpunk

# Window Width
WINDOW_WIDTH=1400

# Window Height
WINDOW_HEIGHT=900

# =============================================================================
# Automation Configuration - Automatisierungseinstellungen
# =============================================================================

# Default Automation Type
DEFAULT_AUTOMATION=email_support

# Auto Start on Boot (true/false)
AUTO_START_ON_BOOT=false

# =============================================================================
# Webhook Configuration - Externe Integrationen
# =============================================================================

# Webhook URL (für externe Benachrichtigungen)
WEBHOOK_URL=

# Webhook Secret (für Sicherheit)
WEBHOOK_SECRET=

# =============================================================================
# Monitoring Configuration - Überwachung
# =============================================================================

# Health Check Interval (in seconds)
HEALTH_CHECK_INTERVAL=60

# Metrics Collection (true/false)
METRICS_COLLECTION=true

# =============================================================================
# Backup Configuration - Datensicherung
# =============================================================================

# Auto Backup Enabled (true/false)
AUTO_BACKUP_ENABLED=true

# Backup to Cloud (true/false)
BACKUP_TO_CLOUD=false

# Cloud Backup Provider (aws, azure, gcp)
CLOUD_BACKUP_PROVIDER=

# =============================================================================
# Development Configuration - Entwicklungseinstellungen
# =============================================================================

# Development Mode (true/false)
DEV_MODE=false

# Test Mode (true/false)
TEST_MODE=false

# Mock APIs (true/false) - für Tests ohne echte APIs
MOCK_APIS=false

# =============================================================================
# Localization - Lokalisierung
# =============================================================================

# Default Language (de, en, fr, es)
DEFAULT_LANGUAGE=de

# Timezone (Europe/Berlin, UTC, etc.)
TIMEZONE=Europe/Berlin

# Date Format
DATE_FORMAT=DD.MM.YYYY

# Time Format
TIME_FORMAT=HH:MM:SS

# =============================================================================
# Notification Configuration - Benachrichtigungen
# =============================================================================

# Email Notifications (true/false)
EMAIL_NOTIFICATIONS=true

# Telegram Notifications (true/false)
TELEGRAM_NOTIFICATIONS=true

# Desktop Notifications (true/false)
DESKTOP_NOTIFICATIONS=true

# =============================================================================
# API Rate Limits - API-Geschwindigkeitsbegrenzungen
# =============================================================================

# OpenAI Rate Limit (requests per minute)
OPENAI_RATE_LIMIT=60

# Gemini Rate Limit (requests per minute)
GEMINI_RATE_LIMIT=60

# Telegram Rate Limit (requests per minute)
TELEGRAM_RATE_LIMIT=30

# =============================================================================
# Error Handling - Fehlerbehandlung
# =============================================================================

# Max Retry Attempts
MAX_RETRY_ATTEMPTS=3

# Retry Delay (in seconds)
RETRY_DELAY=5

# Error Notification Threshold
ERROR_NOTIFICATION_THRESHOLD=5

# =============================================================================
# Logging Configuration - Protokollierung
# =============================================================================

# Log to File (true/false)
LOG_TO_FILE=true

# Log to Console (true/false)
LOG_TO_CONSOLE=true

# Log Rotation (true/false)
LOG_ROTATION=true

# Max Log File Size (in MB)
MAX_LOG_FILE_SIZE=10

# =============================================================================
# Network Configuration - Netzwerkeinstellungen
# =============================================================================

# Proxy Enabled (true/false)
PROXY_ENABLED=false

# Proxy URL
PROXY_URL=

# Proxy Username
PROXY_USERNAME=

# Proxy Password
PROXY_PASSWORD=

# =============================================================================
# SSL Configuration - SSL-Einstellungen
# =============================================================================

# SSL Verification (true/false)
SSL_VERIFICATION=true

# SSL Certificate Path
SSL_CERT_PATH=

# SSL Key Path
SSL_KEY_PATH=

# =============================================================================
# Advanced Configuration - Erweiterte Einstellungen
# =============================================================================

# Custom Model Path
CUSTOM_MODEL_PATH=

# Custom Voice Path
CUSTOM_VOICE_PATH=

# Custom Data Path
CUSTOM_DATA_PATH=

# =============================================================================
# Experimental Features - Experimentelle Funktionen
# =============================================================================

# Quantum Computing Mode (true/false)
QUANTUM_MODE=false

# Neural Network Optimization (true/false)
NEURAL_OPTIMIZATION=false

# AGI Mode (true/false)
AGI_MODE=false

# =============================================================================
# Maintenance Configuration - Wartungseinstellungen
# =============================================================================

# Auto Update (true/false)
AUTO_UPDATE=true

# Update Check Interval (in hours)
UPDATE_CHECK_INTERVAL=24

# Maintenance Mode (true/false)
MAINTENANCE_MODE=false

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
#
# WICHTIGE HINWEISE:
# 1. Ersetze alle "your_*_here" Werte mit deinen echten API-Keys
# 2. Bewahre diese .env Datei sicher auf und teile sie nicht
# 3. Verwende App-Passwörter für E-Mail-Konten
# 4. Überprüfe die API-Limits deiner Dienste
# 5. Teste das System im Test-Modus vor dem Produktiveinsatz
#
# =============================================================================